  font-size:36px;
  margin-bottom:42px;
}

.interest-track article small{
  position:absolute;
  top:24px;
  right:24px;
  color:var(--charvy-red);
  font:600 9px monospace;
}

.interest-track article h3{
  margin:0 0 9px;
  font-size:22px;
}

.interest-track article p{
  max-width:210px;
  font-size:12px;
  line-height:1.6;
  opacity:.55;
}

.interest-scroll{
  margin-top:8px;
  text-align:right;
  font:600 8px monospace;
  letter-spacing:.14em;
  opacity:.4;
}


/* ============================================================
   ANIMATIONS
   ============================================================ */

@keyframes radarSpin{
  from{transform:rotate(0)}
  to{transform:rotate(360deg)}
}

@keyframes cyberGridMove{
  from{background-position:0 0,0 0}
  to{background-position:0 32px,32px 0}
}

@keyframes scanMove{
  0%,100%{top:8%}
  50%{top:92%}
}

@keyframes corePulse{
  50%{transform:translate(-50%,-50%) scale(1.8);opacity:.5}
}

@keyframes nodePulse{
  50%{transform:scale(1.08);box-shadow:0 0 14px rgba(199,91,97,.35)}
}

@keyframes liveBlink{
  50%{opacity:.25}
}

@keyframes consoleBlink{
  50%{opacity:.4}
}

@keyframes meterPulse{
  50%{width:92%}
}

@keyframes carGo{
  0%{left:18%;transform:rotate(0)}
  20%{transform:rotate(-2deg)}
  100%{left:88%;transform:rotate(2deg)}
}

@keyframes traceGo{
  0%{opacity:0;transform:translateX(0)}
  20%{opacity:.8}
  100%{opacity:0;transform:translateX(-40px)}
}

@keyframes printCherry{
  0%{
    opacity:0;
    transform:translateX(-50%) translateY(-25px) scale(.2)
  }
  60%{
    opacity:1;
    transform:translateX(-50%) translateY(0) scale(1.08)
  }
  100%{
    opacity:1;
    transform:translateX(-50%) scale(1)
  }
}

@keyframes sparkPrint{
  0%{opacity:0;transform:translateY(10px)}
  50%{opacity:1}
  100%{opacity:0;transform:translateY(-20px)}
}

@keyframes sendBehind{
  0%{transform:translate(0,0) scale(1);opacity:1}
  100%{transform:translate(-75px,25px) rotate(-8deg) scale(.88);opacity:0}
}

@keyframes comeForward{
  0%{transform:translate(35px,24px) scale(.9);opacity:.4}
  100%{transform:translate(0,0) scale(1);opacity:1}
}


/* ============================================================
   MOBILE
   ============================================================ */

@media(max-width:800px){

  .built-stack{
    grid-template-columns:1fr;
  }

  .cyber-built{
    grid-column:auto;
  }

  .built-heading,
  .table-heading,
  .interest-heading{
    display:block;
  }

  .built-heading>p,
  .table-heading>p,
  .interest-heading p{
    margin-top:20px;
  }

  .built-copy{
    display:block;
  }

  .built-meta{
    margin-top:18px;
  }

  .leadership-mini-head{
    display:block;
  }

  .leadership-mini-head p{
    margin-top:18px;
  }

  .exposure-items{
    grid-template-columns:1fr;
  }

  .skill-deck{
    height:360px;
  }

}

@media(max-width:520px){

  .built-section,
  .table-section,
  .leadership-mini-section,
  .exposure-strip{
    width:calc(100% - 30px);
  }

  .cyber-mini{
    height:260px;
  }

  .cyber-meter{
    display:none;
  }

  .skill-deck{
    height:350px;
  }

  .skill-deck-card{
    padding:27px;
  }

  .skill-deck-card h3{
    font-size:29px;
  }

  .interest-track article{
    flex-basis:230px;
  }

}


