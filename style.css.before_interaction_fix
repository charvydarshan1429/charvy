}


/* ============================================================
   INTERESTS
   ============================================================ */

.interests-final{
  width:100%;
  padding:110px max(24px,calc((100vw - 1180px)/2));
  margin-top:110px;
  background:var(--charvy-cream);
  overflow:hidden;
}

.interest-heading{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:30px;
  margin-bottom:40px;
}

.interest-heading>div>span{
  color:var(--charvy-red);
  font:600 9px monospace;
  letter-spacing:.15em;
}

.interest-heading h2{
  margin:9px 0 0;
  font-size:clamp(48px,6vw,75px);
  line-height:.87;
  letter-spacing:-.065em;
}

.interest-heading h2 em{
  font-family:Georgia,serif;
  font-weight:400;
}

.interest-heading p{
  max-width:270px;
  margin:0;
  font-size:12px;
  line-height:1.6;
  opacity:.55;
}

.interest-track{
  display:flex;
  gap:13px;
  overflow-x:auto;
  scroll-snap-type:x mandatory;
  scrollbar-width:none;
  padding:5px 3px 22px;
}

.interest-track::-webkit-scrollbar{
  display:none;
}

.interest-track article{
  position:relative;
  flex:0 0 245px;
  min-height:260px;
  padding:24px;
  scroll-snap-align:start;
  border:1px solid rgba(23,23,23,.1);
  border-radius:18px;
  background:var(--charvy-white);
  transition:.4s;
