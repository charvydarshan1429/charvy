}

.built-section:after{
  content:"";
  position:absolute;
  z-index:-1;
  left:50%;
  top:-80px;
  bottom:-80px;
  width:100vw;
  transform:translateX(-50%);
  opacity:.3;
  background-image:
    linear-gradient(rgba(0,0,0,.04) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,0,0,.04) 1px,transparent 1px);
  background-size:42px 42px;
}

.built-heading{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:40px;
  margin-bottom:45px;
}

.built-heading>div>span{
  font:600 9px monospace;
  letter-spacing:.16em;
  color:var(--charvy-red);
}

.built-heading h2{
  margin:10px 0 0;
  font-size:clamp(48px,6vw,78px);
