  align-items:end;
  gap:40px;
  margin-bottom:35px;
}

.leadership-heading>span{
  grid-column:1/-1;
  margin-bottom:-25px;
  color:#a72f36;
  font:600 9px monospace;
  letter-spacing:.14em;
}

.leadership-heading h2{
  margin:0;
  font-size:clamp(45px,5vw,65px);
  line-height:.9;
  letter-spacing:-.06em;
}

.leadership-heading h2 em{
  font-family:Georgia,serif;
  font-weight:400;
}

.leadership-heading p{
  max-width:290px;
  margin:0;
  font-size:12px;
  line-height:1.6;
  opacity:.55;
}

.leadership-items{
  display:flex;
  gap:10px;
  overflow-x:auto;
  padding:4px 2px 18px;
  scrollbar-width:none;
}

.leadership-items::-webkit-scrollbar{
  display:none;
}

.leadership-items article{
  flex:0 0 190px;
  min-height:145px;
  padding:20px;
  border:1px solid rgba(23,23,23,.1);
