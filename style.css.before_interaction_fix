/* ============================================================
   BIG WORKSHOPS
   ============================================================ */

.big-exposure{
  width:min(1180px,calc(100% - 48px));
  margin:130px auto;
  padding:75px 0;
  position:relative;
}

.big-exposure:before{
  content:"";
  position:absolute;
  z-index:-2;
  left:50%;
  top:0;
  bottom:0;
  width:100vw;
  transform:translateX(-50%);
  background:#eee9df;
}

.big-exposure:after{
  content:"";
  position:absolute;
  z-index:-1;
  left:50%;
  top:0;
  bottom:0;
  width:100vw;
  transform:translateX(-50%);
  opacity:.3;
  background-image:
    linear-gradient(rgba(0,0,0,.035) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,0,0,.035) 1px,transparent 1px);
  background-size:40px 40px;
}

.exposure-heading{
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:end;
  gap:30px;
  margin-bottom:50px;
}

.exposure-heading>span{
  grid-column:1/-1;
  margin-bottom:-25px;
  color:#a72f36;
  font:600 9px monospace;
  letter-spacing:.15em;
}

.exposure-heading h2{
  margin:0;
  font-size:clamp(55px,7vw,90px);
  line-height:.82;
  letter-spacing:-.07em;
}

.exposure-heading h2 em{
  font-family:Georgia,serif;
  font-weight:400;
}

.exposure-heading p{
  max-width:330px;
  margin:0;
  font-size:13px;
  line-height:1.7;
  opacity:.55;
}

.exposure-grid{
  display:grid;
  grid-template-columns:1.4fr 1fr 1fr;
  gap:12px;
}

.exposure-card{
  min-height:350px;
  padding:28px;
  position:relative;
  overflow:hidden;
  border:1px solid rgba(23,23,23,.1);
  border-radius:20px;
  background:#fffaf2;
  transition:.4s;
}

.exposure-card:hover{
  transform:translateY(-8px);
  box-shadow:0 25px 50px rgba(23,23,23,.1);
}

.exposure-main{
  min-height:400px;
}

.exposure-number{
  color:#a72f36;
  font:600 9px monospace;
}

.exposure-icon{
  margin:28px 0 35px;
  font-size:38px;
}

.exposure-card>span{
  color:#a72f36;
  font:600 8px monospace;
  letter-spacing:.12em;
}

.exposure-card h3{
  margin:9px 0 12px;
  font-size:22px;
  line-height:1.05;
  letter-spacing:-.03em;
}

.exposure-main h3{
  font-size:27px;
}

.exposure-card p{
  font-size:11px;
  line-height:1.7;
  opacity:.55;
}

.exposure-card>b{
  position:absolute;
  left:28px;
  bottom:25px;
  color:#a72f36;
  font:600 8px monospace;
  letter-spacing:.1em;
}

.cyber-training-card{
  background:
    radial-gradient(circle at 80% 15%,rgba(167,47,54,.08),transparent 30%),
    #fffaf2;
}


/* ============================================================
   INTERESTS
   ============================================================ */

.charvy-interests{
  width:100%;
  padding:110px max(24px,calc((100vw - 1180px)/2));
  background:#f4f0e8;
  overflow:hidden;
}

.interests-heading{
  display:flex;
  justify-content:space-between;
  margin-bottom:45px;
}

.interests-heading>span{
  color:#a72f36;
  font:600 9px monospace;
  letter-spacing:.15em;
}

.interests-heading h2{
  margin:0;
  font-size:clamp(48px,6vw,76px);
  line-height:.85;
  letter-spacing:-.065em;
}

.interests-heading h2 em{
  font-family:Georgia,serif;
  font-weight:400;
}

.interest-scroll{
  display:flex;
  gap:13px;
  overflow-x:auto;
  scroll-snap-type:x mandatory;
  scrollbar-width:none;
  padding:4px 3px 20px;
}

.interest-scroll::-webkit-scrollbar{
  display:none;
}

.interest-scroll article{
  flex:0 0 245px;
  min-height:260px;
  padding:24px;
  scroll-snap-align:start;
  position:relative;
  border:1px solid rgba(23,23,23,.1);
  border-radius:18px;
  background:#fffaf2;
  transition:.35s;
}

.interest-scroll article:hover{
  transform:translateY(-8px);
  box-shadow:0 20px 40px rgba(23,23,23,.09);
}

.interest-scroll article>span{
  display:block;
  margin-bottom:45px;
  font-size:35px;
}

.interest-scroll article small{
  position:absolute;
  top:24px;
  right:24px;
  color:#a72f36;
  font:600 9px monospace;
}

.interest-scroll article h3{
  margin:0 0 8px;
  font-size:22px;
}

.interest-scroll article p{
  margin:0;
  font-size:11px;
  line-height:1.6;
  opacity:.55;
}


/* ============================================================
   ANIMATIONS
   ============================================================ */

@keyframes projectBlink{
  50%{opacity:.25}
}

@keyframes cyberGrid{
  from{background-position:0 0,0 0}
  to{background-position:28px 28px,28px 28px}
}

@keyframes radarRotation{
  to{transform:rotate(360deg)}
}

@keyframes coreBeat{
  50%{
    transform:translate(-50%,-50%) scale(1.8);
    opacity:.5;
  }
}

@keyframes threatPulse{
  50%{
    transform:scale(1.12);
    box-shadow:0 0 14px rgba(199,90,96,.35);
  }
}

@keyframes terminalBlink{
  50%{opacity:.35}
}

@keyframes cyberScan{
  0%,100%{top:8%}
  50%{top:92%}
}

@keyframes littleCarDrive{
  0%{
    left:15%;
    transform:rotate(0);
  }
  15%{
    transform:rotate(-2deg);
  }
  100%{
    left:86%;
    transform:rotate(2deg);
  }
}

@keyframes carTrace{
  0%{
    opacity:0;
    transform:translateX(0);
  }
  20%{
    opacity:.8;
  }
  100%{
    opacity:0;
    transform:translateX(-45px);
  }
}

@keyframes printCherry{
  0%{
    opacity:0;
    transform:translateX(-50%) translateY(-22px) scale(.15);
  }
  55%{
    opacity:1;
    transform:translateX(-50%) translateY(0) scale(1.08);
  }
  100%{
    opacity:1;
    transform:translateX(-50%) scale(1);
  }
}

@keyframes printSpark{
  0%{
    opacity:0;
    transform:translateY(8px);
  }
  50%{
    opacity:1;
  }
  100%{
    opacity:0;
    transform:translateY(-20px);
  }
}

@keyframes factorySmoke{
  0%,100%{
    transform:translateY(0) scale(.9);
    opacity:.2;
  }
  50%{
    transform:translateY(-15px) scale(1.25);
    opacity:.4;
  }
}


/* ============================================================
   MOBILE
   ============================================================ */

@media(max-width:850px){

  .built-projects{
    grid-template-columns:1fr;
  }

  .cyber-project{
    grid-column:auto;
    grid-template-columns:1fr;
  }

  .small-project{
    grid-template-columns:1fr;
  }

  .project-visual{
    min-height:230px;
    border-left:0;
    border-top:1px solid rgba(23,23,23,.1);
  }

  .cyber-visual{
    min-height:320px;
  }

  .built-intro,
  .leadership-heading,
  .exposure-heading{
    display:block;
  }

  .built-intro>p,
  .leadership-heading p,
  .exposure-heading p{
    margin-top:20px;
  }

  .exposure-grid{
    grid-template-columns:1fr;
  }

  .exposure-card,
  .exposure-main{
    min-height:330px;
  }

}

@media(max-width:520px){

  .charvy-built,
  .charvy-leadership,
  .big-exposure{
    width:calc(100% - 30px);
  }

  .built-project{
    border-radius:17px;
  }

  .project-copy{
    padding:23px;
  }

  .cyber-radar{
    width:185px;
    height:185px;
  }

  .cyber-terminal{
    font-size:7px;
  }

}


/* ============================================================
   SMALL CYBERSECURITY INTERACTION
   ============================================================ */

.cyber-mini-icon{
  position:absolute;
  right:34px;
  top:50%;
  width:105px;
  height:105px;
  transform:translateY(-50%);
  display:grid;
  place-items:center;
}

.cyber-shield{
  position:relative;
  z-index:5;
  width:68px;
  height:68px;
  border:1px solid rgba(167,47,54,.28);
  border-radius:50%;
  background:#f4f0e8;
  font-size:31px;
  cursor:pointer;
  box-shadow:
    0 12px 28px rgba(23,23,23,.10),
    0 0 0 7px rgba(167,47,54,.035);
  transition:
    transform .3s ease,
    box-shadow .3s ease;
}

.cyber-shield:hover{
  transform:scale(1.1);
  box-shadow:
    0 15px 32px rgba(23,23,23,.14),
    0 0 0 10px rgba(167,47,54,.055);
}

.cyber-shield:active{
  transform:scale(.92);
}

.cyber-orbit{
  position:absolute;
  border:1px solid rgba(167,47,54,.2);
  border-radius:50%;
  pointer-events:none;
}

.orbit-one{
  inset:5px;
  animation:cyberOrbit 7s linear infinite;
}

.orbit-two{
  inset:18px;
  border-style:dashed;
  animation:cyberOrbitReverse 4s linear infinite;
}

.cyber-spark{
  position:absolute;
  z-index:6;
  color:#a72f36;
  font-size:11px;
  pointer-events:none;
}

.spark-a{
  right:2px;
  top:12px;
  animation:cyberSpark 1.8s ease-in-out infinite;
}

.spark-b{
  left:4px;
  bottom:18px;
  animation:cyberSpark 1.5s .3s ease-in-out infinite;
}

.spark-c{
  right:15px;
  bottom:4px;
  animation:cyberSpark 2s .7s ease-in-out infinite;
}

.cyber-mini-icon small{
  position:absolute;
  right:0;
  bottom:-18px;
  color:#a72f36;
  font:600 7px monospace;
  letter-spacing:.13em;
}

.cyber-mini-icon.scanning .cyber-shield{
  animation:cyberPulse .8s ease-in-out 3;
}

@keyframes cyberOrbit{
  to{
    transform:rotate(360deg);
  }
}

@keyframes cyberOrbitReverse{
  to{
    transform:rotate(-360deg);
  }
}

@keyframes cyberSpark{
  0%,100%{
    opacity:.25;
    transform:scale(.8);
  }
  50%{
    opacity:1;
    transform:scale(1.25);
  }
}

@keyframes cyberPulse{
  50%{
    box-shadow:
      0 0 0 13px rgba(167,47,54,.08),
      0 0 28px rgba(167,47,54,.25);
  }
}



