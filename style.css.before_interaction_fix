:root{
  --ink:#171717;
  --muted:#70706d;
  --paper:#f7f3ed;
  --paper2:#eee7de;
  --accent:#a72f36;
  --accent-soft:#c05a60;
  --line:rgba(23,23,23,.14);
  --white:#fffdf8;
  --serif:"Playfair Display",Georgia,serif;
  --sans:"DM Sans",Arial,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.6;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.13;z-index:20;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.13'/%3E%3C/svg%3E")}
a{color:inherit;text-decoration:none}button{font:inherit}
.section{width:min(1180px,calc(100% - 48px));margin:auto}
.cherry-text{color:var(--accent)!important}
.nav-wrap{position:fixed;top:0;left:0;right:0;z-index:30;padding:16px 24px;background:rgba(247,243,237,.78);backdrop-filter:blur(16px);border-bottom:1px solid rgba(23,23,23,.06)}
.nav{width:min(1280px,100%);margin:auto;display:flex;align-items:center;justify-content:space-between;gap:24px}
.logo{font-size:22px;font-weight:700;letter-spacing:-1px}.logo span{color:var(--accent)}
.nav-links{display:flex;gap:30px;font-size:13px;color:#4f4f4c}.nav-links a{position:relative}.nav-links a:after{content:"";position:absolute;left:0;bottom:-6px;width:0;height:1px;background:var(--ink);transition:.3s}.nav-links a:hover:after{width:100%}
.nav-cta{border:1px solid var(--ink);padding:9px 14px;border-radius:100px;font-size:12px;transition:.25s}.nav-cta:hover{background:var(--ink);color:var(--paper)}
.menu-btn{display:none;border:0;background:none;font-size:22px}
.hero{min-height:100vh;padding-top:140px;padding-bottom:80px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:90px}
.eyebrow,.kicker{font-size:11px;text-transform:uppercase;letter-spacing:2px;font-weight:700;color:var(--muted)}
.eyebrow{display:flex;align-items:center;gap:9px}.dot{width:7px;height:7px;border-radius:50%;background:var(--accent);display:inline-block}
.hero h1{font-size:clamp(54px,7vw,92px);line-height:.98;letter-spacing:-5px;margin:22px 0 28px;font-weight:600}.hero h1 span{font-style:italic;font-family:var(--serif);font-weight:500;color:var(--accent)}
.hero-text{max-width:600px;font-size:17px;color:#5d5c58;line-height:1.75}.hero-actions{display:flex;align-items:center;gap:28px;margin-top:36px}
.btn{display:inline-flex;align-items:center;gap:22px;padding:15px 20px;border-radius:2px;font-size:13px;font-weight:600}.btn-dark{background:var(--ink);color:var(--white);transition:.3s}.btn-dark:hover{transform:translateY(-3px);box-shadow:0 10px 30px rgba(0,0,0,.15)}
.text-link{font-size:13px;border-bottom:1px solid var(--ink);padding-bottom:4px}
.hero-card{background:#ded8cd;padding:18px;min-height:560px;display:flex;flex-direction:column;justify-content:space-between;transform:rotate(1.4deg);box-shadow:25px 30px 70px rgba(0,0,0,.09)}
.card-top,.card-bottom{display:flex;justify-content:space-between;align-items:center;font-size:10px;letter-spacing:1.5px;color:#67655f}.card-mark{font-weight:700;color:var(--accent);letter-spacing:2px}.card-bottom{letter-spacing:0;font-size:11px}.card-bottom strong,.card-bottom span{display:block}.card-bottom strong{font-size:17px;color:var(--ink);margin-bottom:3px}.availability{display:flex!important;gap:7px;align-items:center}.availability i{width:6px;height:6px;border-radius:50%;background:#667b58;display:block}
.portrait-placeholder{margin:20px 0;flex:1;position:relative;overflow:hidden;background:linear-gradient(145deg,#252525,#6e665b);display:grid;place-items:center}.portrait-placeholder:before{content:"";position:absolute;width:70%;height:130%;border-radius:50%;border:1px solid rgba(255,255,255,.2);transform:rotate(25deg)}
.initials{font-family:var(--serif);font-size:130px;color:#e9e2d7;position:relative;z-index:2;font-style:italic}.orbit{position:absolute;border:1px solid rgba(255,255,255,.18);border-radius:50%;width:90%;height:45%;transform:rotate(-20deg)}.orbit-2{width:65%;height:70%;transform:rotate(55deg)}
.marquee{border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden;padding:15px 0;background:var(--paper2)}.marquee-track{display:flex;width:max-content;gap:28px;align-items:center;animation:scroll 28s linear infinite;font-size:12px;letter-spacing:2px;font-weight:700}.marquee b{font-size:15px;color:var(--accent)}@keyframes scroll{to{transform:translateX(-50%)}}
.about{padding-top:145px;padding-bottom:130px}.section-label{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);border-top:1px solid var(--line);padding-top:14px}
.about-content{display:grid;grid-template-columns:.85fr 1.15fr;gap:100px;margin-top:55px}.about-title h2,.skills-heading h2,.journey h2{font-size:clamp(42px,5vw,68px);line-height:1.02;letter-spacing:-3px;margin-top:18px}.about-text{max-width:680px}.about-text p{color:#5f5d58;margin-bottom:18px;font-size:15px}.about-text .lead{font-size:20px;color:var(--ink);line-height:1.55}.about-text strong{color:var(--ink)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:80px}.stats div{padding:28px 20px;border-right:1px solid var(--line)}.stats div:last-child{border:0}.stats strong{font-family:var(--serif);font-size:40px;font-weight:500;display:block}.stats span{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:var(--muted)}
.skills{padding-bottom:145px}.skills-heading{display:flex;justify-content:space-between;align-items:end;gap:40px;margin:50px 0 60px}.skills-heading p,.projects-heading p{max-width:380px;color:var(--muted);font-size:14px}
.skill-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.skill-card{background:var(--paper);min-height:205px;padding:28px;position:relative;transition:.3s}.skill-card:hover{background:var(--paper2);transform:translateY(-4px)}.number{font-size:10px;letter-spacing:2px;color:var(--accent)}.skill-card h3{font-size:21px;margin:38px 0 8px}.skill-card p{font-size:13px;color:var(--muted)}
.projects{padding-bottom:145px}.projects-heading{margin:50px 0 60px;display:flex;justify-content:space-between;align-items:end;gap:30px}.project-list{border-top:1px solid var(--line)}.project{display:grid;grid-template-columns:70px 1fr 170px;gap:30px;padding:40px 0;border-bottom:1px solid var(--line);transition:.35s}.project:hover{padding-left:12px;padding-right:12px;background:rgba(238,231,222,.45)}.project-index{font-size:11px;color:var(--accent);padding-top:6px}.project-type{font-size:10px;letter-spacing:1.6px;color:var(--muted);font-weight:700}.project h3{font-size:31px;letter-spacing:-1px;margin:9px 0 12px}.project p:not(.project-type){max-width:720px;color:var(--muted);font-size:14px}.tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:18px}.tags span{border:1px solid var(--line);border-radius:100px;padding:5px 10px;font-size:10px;color:#5f5d58}.project-mark{font-family:var(--serif);font-size:60px;line-height:.8;text-align:right;color:#b6afa3;font-style:italic}.project-mark small{font-family:var(--sans);font-size:9px;font-style:normal;letter-spacing:2px}
.journey{padding-bottom:150px}.journey-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:110px;margin-top:55px}.timeline-item{display:grid;grid-template-columns:120px 1fr;gap:20px;padding:0 0 38px;margin-bottom:38px;border-bottom:1px solid var(--line)}.timeline-item:last-child{border:0}.timeline-item>span{font-size:11px;color:var(--muted);padding-top:5px}.timeline-item h3{font-size:18px}.timeline-item p{font-size:13px;color:var(--muted);margin:5px 0}.timeline-item b{font-size:11px;color:var(--accent)}
.grade-note{display:flex;gap:10px;margin-top:45px;flex-wrap:wrap}.grade-note div{min-width:92px;padding:14px 15px;border:1px solid rgba(167,47,54,.2);background:rgba(167,47,54,.035);border-radius:2px}.grade-note strong{display:block;font-family:var(--serif);font-size:29px;color:var(--accent);font-weight:500}.grade-note span{font-size:9px;text-transform:uppercase;letter-spacing:1px;color:var(--muted)}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:100px;border-top:1px solid var(--line);padding-top:55px;margin-top:25px}.mini-section ul{list-style:none;margin-top:18px}.mini-section li{font-size:14px;padding:13px 0;border-bottom:1px solid var(--line);color:#56544f}.mini-section li:before{content:"↳";color:var(--accent);margin-right:10px}.achievements{margin-top:100px;border-top:1px solid var(--line);padding-top:30px}.achievement-row{display:grid;grid-template-columns:45px 1fr;gap:20px;border-bottom:1px solid var(--line);padding:20px 0}.achievement-row span{font-size:10px;color:var(--accent)}.achievement-row p{font-size:14px}
.contact{background:var(--ink);color:var(--white);position:relative;overflow:hidden}.contact:after{content:"CV";font-family:var(--serif);font-style:italic;position:absolute;right:-30px;bottom:-130px;font-size:360px;line-height:1;color:rgba(255,255,255,.035);pointer-events:none}.contact-inner{padding-top:130px;padding-bottom:130px;position:relative;z-index:2}.contact .eyebrow{color:#a9a59d}.contact h2{font-size:clamp(55px,8vw,105px);line-height:.93;letter-spacing:-5px;margin:25px 0}.contact-copy{max-width:500px;color:#aaa7a0;font-size:15px}.email{display:inline-flex;align-items:center;gap:30px;margin-top:45px;font-size:18px;border-bottom:1px solid #6b6862;padding-bottom:8px;transition:.3s}.email:hover{color:#ddd}
footer{background:var(--ink);border-top:1px solid rgba(255,255,255,.12);color:#77736c;padding:20px 24px;display:flex;justify-content:space-between;font-size:10px;letter-spacing:1px;text-transform:uppercase}footer a{color:#aaa69e}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .8s ease,transform .8s ease}.reveal.visible{opacity:1;transform:none}.delay-1{transition-delay:.1s}.delay-2{transition-delay:.2s}
.cursor-glow{position:fixed;width:280px;height:280px;border-radius:50%;pointer-events:none;z-index:1;background:radial-gradient(circle,rgba(167,47,54,.09),transparent 65%);transform:translate(-50%,-50%);left:50%;top:50%;transition:left .12s ease-out,top .12s ease-out}
.cherry-field{position:fixed;inset:0;pointer-events:none;z-index:5;overflow:hidden}.cherry{position:absolute;color:var(--accent);font-size:8px;opacity:.48;transition:transform .25s ease-out;filter:drop-shadow(0 2px 3px rgba(80,0,0,.15))}.c1{left:7%;top:22%}.c2{left:92%;top:18%;font-size:6px}.c3{left:84%;top:68%;font-size:9px}.c4{left:12%;top:78%;font-size:6px}.c5{left:48%;top:11%;font-size:5px}.c6{left:55%;top:88%;font-size:7px}
@media(max-width:850px){.nav-links,.nav-cta{display:none}.menu-btn{display:block}.nav-links.mobile-open{display:flex;position:absolute;top:67px;left:0;right:0;padding:22px 24px;background:var(--paper);flex-direction:column;gap:18px;border-bottom:1px solid var(--line)}.hero{grid-template-columns:1fr;gap:55px;padding-top:120px}.hero-card{min-height:460px;transform:none}.about-content,.journey-grid{grid-template-columns:1fr;gap:45px}.skills-heading,.projects-heading{display:block}.skills-heading p,.projects-heading p{margin-top:22px}.skill-grid{grid-template-columns:1fr 1fr}.project{grid-template-columns:45px 1fr}.project-mark{display:none}.two-col{gap:45px}}
@media(max-width:560px){.section{width:min(100% - 32px,1180px)}.nav-wrap{padding:15px 16px}.hero h1{font-size:52px;letter-spacing:-3px}.hero-text{font-size:15px}.hero-actions{align-items:flex-start;flex-direction:column;gap:18px}.stats{grid-template-columns:1fr 1fr}.stats div:nth-child(2){border-right:0}.stats div{border-bottom:1px solid var(--line)}.stats div:nth-child(3),.stats div:nth-child(4){border-bottom:0}.skill-grid{grid-template-columns:1fr}.project h3{font-size:24px}.timeline-item{grid-template-columns:1fr;gap:4px}.two-col{grid-template-columns:1fr;gap:40px}.contact-inner{padding-top:100px;padding-bottom:100px}.contact h2{letter-spacing:-3px}}


/* ============================================================
   CHARVY CYBERSECURITY PROJECT
============================================================ */

.cyber-specs{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:1px;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.08);
  margin:24px 0 20px;
}

.cyber-specs > div{
  background:#0c0e0f;
  padding:15px;
  transition:.3s ease;
}

.cyber-specs > div:hover{
  background:#111718;
  transform:translateY(-2px);
}

.cyber-specs span{
  display:block;
  font-family:var(--mono);
  font-size:8px;
  letter-spacing:1.5px;
  color:var(--cyan);
  margin-bottom:7px;
}

.cyber-specs b{
  display:block;
  font-size:12px;
  color:#eeeae3;
  font-weight:500;
}

.cyber-specs small{
  display:block;
  color:#737b77;
  font-family:var(--mono);
  font-size:8px;
  line-height:1.5;
  margin-top:6px;
}


/* ============================================================
   ONGOING PROJECT
============================================================ */

.ongoing-note{
  display:grid;
  grid-template-columns:120px 1fr 2fr;
  align-items:center;
  gap:22px;
  margin:0 0 30px;
  padding:18px 20px;
  border:1px solid rgba(167,47,54,.25);
  background:rgba(167,47,54,.04);
  transition:.35s ease;
}

.ongoing-note:hover{
  border-color:rgba(167,47,54,.5);
  transform:translateY(-3px);
}

.ongoing-note > span{
  font-family:var(--mono);
  font-size:8px;
  letter-spacing:1.5px;
  color:var(--accent);
}

.ongoing-note strong{
  font-family:var(--serif);
  font-size:21px;
  font-weight:500;
  color:var(--accent);
}

.ongoing-note p{
  font-size:11px;
  line-height:1.55;
  color:var(--muted);
}


/* ============================================================
   CYBERSECURITY WORKFLOW
============================================================ */

.cyber-flow{
  display:grid;

  grid-template-columns:
    1fr auto
    1fr auto
    1fr auto
    1fr auto
    1fr;

  align-items:stretch;

  gap:10px;

  margin:25px 0 35px;

  padding:16px;

  border:1px solid var(--line);

  background:rgba(235,228,217,.5);

  transition:.4s ease;
}

.cyber-flow:hover{
  border-color:rgba(167,47,54,.3);
  box-shadow:0 20px 45px rgba(17,17,15,.07);
}

.cyber-flow > div{
  padding:11px;
}

.cyber-flow span{
  display:block;

  font-family:var(--mono);

  font-size:8px;

  letter-spacing:1.5px;

  color:var(--accent);

  margin-bottom:9px;
}

.cyber-flow b{
  display:block;

  font-size:10px;

  letter-spacing:1px;
}

.cyber-flow small{
  display:block;

  color:var(--muted);

  font-size:9px;

  line-height:1.45;

  margin-top:6px;
}

.cyber-flow > i{
  font-style:normal;

  color:var(--accent);

  align-self:center;

  font-size:18px;

  transition:.3s;
}

.cyber-flow:hover > i{
  transform:translateX(4px);
}


/* ============================================================
   MOBILE
============================================================ */

@media(max-width:900px){

  .cyber-flow{
    grid-template-columns:1fr 1fr;
  }

  .cyber-flow > i{
    display:none;
  }

}

@media(max-width:760px){

  .ongoing-note{
    grid-template-columns:1fr;
    gap:8px;
  }

}

@media(max-width:520px){

  .cyber-specs{
    grid-template-columns:1fr;
  }

  .cyber-flow{
    grid-template-columns:1fr;
  }

  .cyber-flow > div{
    border-bottom:1px solid var(--line);
  }

}


/* =========================================================
   CHARVY — CYBERSECURITY + INTERESTS VISUAL UPGRADE
   ========================================================= */

/* ---------- CYBERSECURITY ---------- */

.cyber-visual{
    position:relative;
    width:100%;
    min-height:390px;
    margin:32px 0;
    overflow:hidden;
    border:1px solid rgba(60,220,255,.35);
    border-radius:24px;
    background:
        radial-gradient(circle at 50% 50%,rgba(0,190,255,.12),transparent 32%),
        #030911;
    box-shadow:
        0 0 70px rgba(0,180,255,.08),
        inset 0 0 80px rgba(0,180,255,.05);
}

.cyber-visual:before{
    content:"";
    position:absolute;
    inset:0;
    background-image:
        linear-gradient(rgba(70,220,255,.055) 1px,transparent 1px),
        linear-gradient(90deg,rgba(70,220,255,.055) 1px,transparent 1px);
    background-size:34px 34px;
    animation:cyberGrid 5s linear infinite;
}

.cyber-status{
    position:absolute;
    top:22px;
    left:24px;
    z-index:5;
    font:600 10px/1 monospace;
    letter-spacing:.18em;
    color:#71eaff;
}

.status-dot{
    display:inline-block;
    width:7px;
    height:7px;
    margin-right:8px;
    border-radius:50%;
    background:#40e2ff;
    box-shadow:0 0 15px #40e2ff;
    animation:statusPulse 1s infinite;
}

.cyber-radar{
    position:absolute;
    width:250px;
    height:250px;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    border:1px solid rgba(64,226,255,.35);
    border-radius:50%;
}

.radar-ring{
    position:absolute;
    border:1px solid rgba(64,226,255,.18);
    border-radius:50%;
    inset:12%;
}

.ring-two{inset:27%}
.ring-three{inset:42%}

.radar-cross{
    position:absolute;
    background:rgba(64,226,255,.18);
}

.radar-cross.vertical{
    width:1px;
    height:100%;
    left:50%;
    top:0;
}

.radar-cross.horizontal{
    height:1px;
    width:100%;
    left:0;
    top:50%;
}

.radar-sweep{
    position:absolute;
    width:50%;
    height:2px;
    left:50%;
    top:50%;
    transform-origin:left center;
    background:linear-gradient(90deg,#4ce7ff,transparent);
    box-shadow:0 0 15px #4ce7ff;
    animation:radarRotate 2.8s linear infinite;
}

.radar-center{
    position:absolute;
    width:9px;
    height:9px;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    border-radius:50%;
    background:#72edff;
    box-shadow:0 0 20px #40e2ff;
    animation:centerPulse 1.4s infinite;
}

.radar-node{
    position:absolute;
    z-index:3;
    padding:7px 9px;
    border:1px solid rgba(64,226,255,.5);
    background:rgba(2,12,20,.9);
    color:#8defff;
    font:600 9px monospace;
    box-shadow:0 0 18px rgba(64,226,255,.18);
    animation:nodeFloat 2s ease-in-out infinite;
}

.node-one{left:-35px;top:25%}
.node-two{right:-35px;top:18%;animation-delay:.5s}
.node-three{left:-25px;bottom:20%;animation-delay:1s}
.node-four{right:-25px;bottom:25%;animation-delay:1.5s}

.cyber-terminal{
    position:absolute;
    left:24px;
    bottom:24px;
    z-index:4;
    width:260px;
    padding:14px 16px;
    border-left:2px solid #40e2ff;
    background:rgba(2,9,15,.75);
    backdrop-filter:blur(8px);
    font:11px/1.8 monospace;
    color:#79d9e8;
}

.terminal-result{
    color:#fff;
    animation:terminalBlink 1.2s infinite;
}

.cyber-meter{
    position:absolute;
    right:24px;
    bottom:25px;
    z-index:4;
    width:180px;
    font:9px monospace;
    color:#6fe9ff;
    letter-spacing:.12em;
}

.meter-track{
    height:4px;
    margin:10px 0;
    background:rgba(255,255,255,.1);
    overflow:hidden;
}

.meter-track i{
    display:block;
    height:100%;
    width:72%;
    background:#40e2ff;
    box-shadow:0 0 12px #40e2ff;
    animation:meterScan 2s ease-in-out infinite;
}

.cyber-meter b{
    font-size:9px;
    font-weight:500;
}

.cyber-scan-line{
    position:absolute;
    z-index:2;
    left:0;
    right:0;
    top:0;
    height:2px;
    background:#40e2ff;
    box-shadow:0 0 18px #40e2ff;
    opacity:.55;
    animation:scanLine 3.2s ease-in-out infinite;
}

.ongoing-badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    margin:12px 0;
    padding:8px 13px;
    border:1px solid rgba(64,226,255,.45);
    border-radius:100px;
    color:#40e2ff;
    background:rgba(64,226,255,.06);
    font:600 10px monospace;
    letter-spacing:.12em;
}

.ongoing-badge::first-letter{
    animation:statusPulse 1s infinite;
}

/* ---------- INTERESTS ---------- */

.charvy-interests{
    position:relative;
    width:min(1180px,calc(100% - 48px));
    margin:120px auto;
    padding:90px 0;
}

.charvy-interests:before{
    content:"";
    position:absolute;
    left:50%;
    top:0;
    bottom:0;
    width:100vw;
    transform:translateX(-50%);
    z-index:-2;
    background:#f3efe7;
}

.charvy-interests:after{
    content:"";
    position:absolute;
    left:50%;
    top:0;
    bottom:0;
    width:100vw;
    transform:translateX(-50%);
    z-index:-1;
    opacity:.45;
    background-image:
        linear-gradient(rgba(0,0,0,.035) 1px,transparent 1px),
        linear-gradient(90deg,rgba(0,0,0,.035) 1px,transparent 1px);
    background-size:40px 40px;
}

.interest-top{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:40px;
    margin-bottom:55px;
}

.mini-label{
    font:600 10px monospace;
    letter-spacing:.18em;
    opacity:.55;
    margin-bottom:18px;
}

.interest-top h2{
    margin:0;
    font-size:clamp(50px,7vw,94px);
    line-height:.86;
    letter-spacing:-.065em;
}

.interest-top h2 span{
    font-family:Georgia,serif;
    font-weight:400;
}

.interest-top>p{
    max-width:290px;
    margin:0 0 5px;
    font-size:14px;
    line-height:1.7;
    opacity:.6;
}

.interest-cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:16px;
}

.interest-card{
    position:relative;
    min-height:245px;
    padding:27px;
    overflow:hidden;
    background:rgba(255,255,255,.68);
    border:1px solid rgba(20,20,20,.12);
    transition:
        transform .45s cubic-bezier(.2,.8,.2,1),
        box-shadow .45s,
        border-color .45s;
}

.interest-card:hover{
    transform:translateY(-10px) rotate(-.6deg);
    border-color:#a72f36;
    box-shadow:0 24px 55px rgba(0,0,0,.12);
}

.interest-card:before{
    content:"";
    position:absolute;
    width:130px;
    height:130px;
    right:-60px;
    bottom:-60px;
    border-radius:50%;
    background:#a72f36;
    opacity:.08;
    transition:transform .5s;
}

.interest-card:hover:before{
    transform:scale(2);
}

.interest-icon{
    font-size:36px;
    line-height:1;
    margin-bottom:30px;
    transition:transform .4s;
}

.interest-card:hover .interest-icon{
    transform:translateY(-5px) scale(1.12) rotate(-5deg);
}

.interest-number{
    position:absolute;
    top:25px;
    right:25px;
    font:10px monospace;
    opacity:.3;
}

.interest-card h3{
    position:relative;
    margin:0 0 9px;
    font-size:23px;
    letter-spacing:-.03em;
}

.interest-card p{
    position:relative;
    max-width:270px;
    margin:0;
    font-size:13px;
    line-height:1.65;
    opacity:.58;
}

.interest-line{
    position:absolute;
    left:27px;
    bottom:22px;
    width:30px;
    height:2px;
    background:#a72f36;
    transition:width .4s;
}

.interest-card:hover .interest-line{
    width:80px;
}

/* ---------- ANIMATIONS ---------- */

@keyframes radarRotate{
    from{transform:rotate(0deg)}
    to{transform:rotate(360deg)}
}

@keyframes scanLine{
    0%,100%{top:8%}
    50%{top:92%}
}

@keyframes cyberGrid{
    from{background-position:0 0,0 0}
    to{background-position:0 34px,34px 0}
}

@keyframes statusPulse{
    50%{opacity:.25;transform:scale(.7)}
}

@keyframes centerPulse{
    50%{transform:translate(-50%,-50%) scale(1.7);opacity:.5}
}

@keyframes nodeFloat{
    50%{transform:translateY(-5px)}
}

@keyframes terminalBlink{
    50%{opacity:.45}
}

@keyframes meterScan{
    0%,100%{width:48%}
    50%{width:92%}
}

/* ---------- MOBILE ---------- */

@media(max-width:800px){

    .interest-top{
        display:block;
    }

    .interest-top>p{
        margin-top:25px;
    }

    .interest-cards{
        grid-template-columns:1fr 1fr;
    }

    .cyber-visual{
        min-height:350px;
    }

    .cyber-terminal{
        width:220px;
        font-size:9px;
    }

    .cyber-meter{
        display:none;
    }
}

@media(max-width:520px){

    .charvy-interests{
        width:calc(100% - 30px);
        padding:65px 0;
        margin:80px auto;
    }

    .interest-cards{
        grid-template-columns:1fr;
    }

    .interest-card{
        min-height:205px;
    }

    .cyber-radar{
        width:190px;
        height:190px;
    }

    .cyber-terminal{
        left:15px;
        bottom:15px;
        width:190px;
    }

    .cyber-status{
        left:15px;
        top:16px;
        font-size:8px;
    }

}


