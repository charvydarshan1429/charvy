}

.exposure-card:hover,
.exposure-big-card:hover{
  transform:translateY(-8px);
  box-shadow:0 25px 50px rgba(23,23,23,.1);
}

.exposure-no{
  color:#a72f36;
  font:600 9px monospace;
}

.exposure-emoji{
  margin:30px 0 34px;
  font-size:38px;
}

.exposure-card small,
.exposure-big-card small{
  color:#a72f36;
  font:600 8px monospace;
  letter-spacing:.12em;
}

.exposure-card h3,
.exposure-big-card h3{
  margin:10px 0;
  font-size:21px;
  line-height:1.08;
  letter-spacing:-.03em;
}

.exposure-big-card h3{
  font-size:27px;
}

.exposure-card p,
.exposure-big-card p{
  margin:0;
  font-size:11px;
  line-height:1.7;
  opacity:.55;
}

.exposure-card>b,
.exposure-big-card>b{
  position:absolute;
  left:28px;
  bottom:25px;
  color:#a72f36;
  font:600 8px monospace;
  letter-spacing:.1em;
}

.tiny-cherry{
  position:absolute;
  right:18px;
  top:18px;
  font-size:19px;
  animation:tinyCherryFloat 2.7s ease-in-out infinite;
}

.cherry-two{
  animation-delay:.4s;
}

.cherry-three{
  animation-delay:.8s;
}

@keyframes tinyCherryFloat{
  0%,100%{
    transform:translateY(0) rotate(-8deg);
  }
  50%{
    transform:translateY(-7px) rotate(8deg);
  }
}


