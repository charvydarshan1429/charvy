/* ============================================================
   CARD DECK
   ============================================================ */

.table-section{
  width:min(1180px,calc(100% - 48px));
  margin:120px auto;
  position:relative;
}

.table-heading{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:35px;
  margin-bottom:45px;
}

.table-heading>div>span{
  font:600 9px monospace;
  letter-spacing:.15em;
  color:var(--charvy-red);
}

.table-heading h2{
  margin:9px 0 0;
  font-size:clamp(48px,6vw,78px);
  line-height:.87;
  letter-spacing:-.065em;
}

.table-heading h2 em{
  font-family:Georgia,serif;
  font-weight:400;
}

.table-heading>p{
  max-width:280px;
  font-size:13px;
  line-height:1.6;
  opacity:.55;
}

.skill-deck{
  position:relative;
  width:100%;
  max-width:680px;
  height:370px;
  margin:0 auto;
  perspective:1200px;
}

.skill-deck-card{
  position:absolute;
  inset:0;
  padding:34px;
  border:1px solid rgba(23,23,23,.13);
  border-radius:25px;
  background:var(--charvy-white);
  box-shadow:0 20px 50px rgba(23,23,23,.08);
  cursor:grab;
  user-select:none;
  transition:
    transform .5s cubic-bezier(.2,.8,.2,1),
    opacity .35s,
    filter .35s,
    box-shadow .35s;
}

.skill-deck-card:not(.active-card){
  transform:translate(15px,12px) scale(.95);
  opacity:.7;
  filter:saturate(.7);
  z-index:1;
}

.skill-deck-card.active-card{
  z-index:20;
}

.skill-deck-card:nth-child(3){
  transform:translate(30px,24px) scale(.9);
  z-index:0;
  opacity:.45;
}

.skill-deck-card:nth-child(n+4){
  opacity:0;
  pointer-events:none;
}

.skill-deck-card.card-behind{
  animation:sendBehind .55s cubic-bezier(.2,.8,.2,1) forwards;
}

.skill-deck-card.card-coming{
  animation:comeForward .55s cubic-bezier(.2,.8,.2,1) forwards;
}

.deck-icon{
  display:block;
  font-size:42px;
  margin-bottom:42px;
}

.skill-deck-card small{
  display:block;
  color:var(--charvy-red);
  font:600 9px monospace;
  letter-spacing:.13em;
}

.skill-deck-card h3{
  margin:10px 0;
  font-size:34px;
  letter-spacing:-.05em;
}

.skill-deck-card p{
  max-width:450px;
  font-size:14px;
  line-height:1.7;
  opacity:.58;
}

.skill-deck-card b{
  position:absolute;
  bottom:27px;
  left:34px;
  color:var(--charvy-red);
  font:600 8px monospace;
  letter-spacing:.13em;
}

.deck-controls{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:25px;
  margin-top:24px;
}

.deck-controls button{
  width:38px;
  height:38px;
  border:1px solid rgba(23,23,23,.18);
  border-radius:50%;
  background:transparent;
  cursor:pointer;
  transition:.25s;
}

.deck-controls button:hover{
  background:var(--charvy-red);
  color:white;
  border-color:var(--charvy-red);
}

.deck-controls div{
  font:700 12px monospace;
}

.deck-controls div span{
  color:var(--charvy-red);
}

.deck-controls div small{
  opacity:.4;
}


/* ============================================================
   LEADERSHIP
   ============================================================ */

.leadership-mini-section{
