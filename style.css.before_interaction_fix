    right:50%;
    top:60%;
    transform:translate(50%,-50%);
  }

  .proud-grid{
    grid-template-columns:1fr;
  }

}


/* ============================================================
   FACTORY STEEL RODS — TAP TO RELEASE
   ============================================================ */

.steel-visual .steel-rods{
  transition:
    transform 1s cubic-bezier(.2,.8,.2,1),
    opacity .8s;
}

.steel-visual.steel-active .steel-rods{
  transform:
    translateX(95px)
    rotate(-8deg);
}

.steel-visual.steel-active .steel-rods i:nth-child(1){
  animation:rodPush 1.1s ease-out;
}

.steel-visual.steel-active .steel-rods i:nth-child(2){
  animation:rodPush 1.1s .12s ease-out;
}

.steel-visual.steel-active .steel-rods i:nth-child(3){
  animation:rodPush 1.1s .24s ease-out;
}

@keyframes rodPush{
  0%{
    transform:translateX(-45px);
    opacity:.35;
  }
  60%{
    transform:translateX(12px);
    opacity:1;
  }
  100%{
    transform:translateX(0);
    opacity:1;
  }
}


