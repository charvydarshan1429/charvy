}

.cyber-meter i{
  display:block;
  width:65%;
  height:100%;
  background:#c75b61;
  box-shadow:0 0 10px rgba(199,91,97,.7);
  animation:meterPulse 2s infinite;
}

.cyber-scan{
  position:absolute;
  z-index:4;
  left:0;
  right:0;
  top:0;
  height:1px;
  background:#c75b61;
  box-shadow:0 0 13px #c75b61;
