/* ============================================================
   EXPOSURE
   ============================================================ */

.exposure-strip{
  width:min(1180px,calc(100% - 48px));
  margin:100px auto;
}

.exposure-title{
  margin-bottom:25px;
}

.exposure-title>span{
  font:600 9px monospace;
  color:var(--charvy-red);
