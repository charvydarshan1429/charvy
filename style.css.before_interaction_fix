  opacity:.55;
}


/* WORKSHOPS */

.workshop-list{
  display:grid;
  gap:12px;
}

.workshop-card{
  display:grid;
  grid-template-columns:70px 1fr auto;
  align-items:center;
  gap:25px;
  padding:24px;
  background:#fffaf2;
  border:1px solid rgba(23,23,23,.1);
  transition:.35s;
}

.workshop-card:hover{
  transform:translateX(8px);
  border-color:rgba(167,47,54,.35);
}

.workshop-icon{
  width:55px;
  height:55px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:rgba(167,47,54,.08);
  font-size:26px;
}

.workshop-content>span{
  font:600 8px monospace;
  color:var(--charvy-red);
  letter-spacing:.1em;
}

.workshop-content h3{
  margin:6px 0;
  font-size:19px;
}

.workshop-content p{
  margin:0;
  font-size:12px;
  opacity:.55;
}

.workshop-card>b{
  font:600 8px monospace;
  opacity:.45;
}


/* ACHIEVEMENTS */

.proud-heading{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:45px;
}

.floating-cherry{
  font-size:54px;
  animation:cherryFloat 3s ease-in-out infinite;
}

.proud-cards{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
}

.proud-card{
  position:relative;
  min-height:280px;
  padding:25px;
  background:#fffaf2;
  border:1px solid rgba(23,23,23,.1);
  overflow:hidden;
  transition:.45s cubic-bezier(.2,.8,.2,1);
}

.proud-card:after{
  content:"";
  position:absolute;
  width:110px;
  height:110px;
  border-radius:50%;
  right:-55px;
  bottom:-55px;
  background:var(--charvy-red);
  opacity:.06;
  transition:.5s;
}

.proud-card:hover{
  transform:translateY(-10px);
  box-shadow:0 22px 45px rgba(23,23,23,.11);
}

.proud-card:hover:after{
  transform:scale(2);
}

.proud-top{
  display:flex;
  justify-content:space-between;
  font:10px monospace;
  color:var(--charvy-red);
}

.proud-top i{
  font-style:normal;
}

.trophy{
  margin:30px 0 20px;
  font-size:31px;
}

.proud-card h3{
  font-size:19px;
  margin-bottom:9px;
}

.proud-card p{
  font-size:12px;
  line-height:1.6;
  opacity:.57;
}


/* INTERESTS */

.interests-new{
  margin-bottom:130px;
}

.interest-title{
  margin-bottom:42px;
}

.interest-title>p{
  max-width:360px;
  margin-top:20px;
  font-size:13px;
  opacity:.55;
}

.interest-swipe{
  display:flex;
  gap:15px;
  overflow-x:auto;
  padding:5px 5px 25px;
  scroll-snap-type:x mandatory;
  scrollbar-width:none;
}

.interest-swipe::-webkit-scrollbar{
  display:none;
}

.interest-new-card{
  flex:0 0 255px;
  min-height:285px;
  scroll-snap-align:start;
  padding:25px;
  position:relative;
  overflow:hidden;
  background:#fffaf2;
  border:1px solid rgba(23,23,23,.1);
  transition:.4s;
}

.interest-new-card:hover{
  transform:translateY(-8px) rotate(-1deg);
  border-color:rgba(167,47,54,.35);
  box-shadow:0 20px 45px rgba(23,23,23,.1);
}

.interest-new-card:before{
  content:"";
  position:absolute;
  width:130px;
  height:130px;
  right:-65px;
  bottom:-65px;
  border-radius:50%;
  background:var(--charvy-red);
  opacity:.07;
}

.interest-emoji{
  display:block;
  font-size:39px;
  margin-bottom:45px;
}

.interest-new-card small{
  position:absolute;
  top:25px;
  right:25px;
  font:9px monospace;
  color:var(--charvy-red);
}

.interest-new-card h3{
  font-size:23px;
  margin:0 0 9px;
}

.interest-new-card p{
  font-size:12px;
  line-height:1.6;
  opacity:.55;
}

.interest-new-card b{
  position:absolute;
  bottom:22px;
  left:25px;
  font:600 8px monospace;
  letter-spacing:.12em;
  color:var(--charvy-red);
}

.swipe-hint{
  margin-top:12px;
  text-align:right;
  font:600 8px monospace;
  letter-spacing:.14em;
  opacity:.4;
}


/* ============================================================
   ANIMATIONS
   ============================================================ */

@keyframes idGlow{
  0%,100%{transform:translate(-50%,-50%) scale(.8);opacity:.6}
  50%{transform:translate(-50%,-50%) scale(1.3);opacity:1}
}

@keyframes livePulse{
  50%{opacity:.25;transform:scale(.65)}
}

@keyframes orbitSpin{
  to{transform:rotate(360deg) scaleY(.48)}
}

@keyframes starFloat{
  50%{transform:translateY(-7px) rotate(10deg)}
}

@keyframes carDrive{
  0%{left:20%;transform:rotate(0)}
  15%{transform:rotate(-2deg)}
  100%{left:85%;transform:rotate(1deg)}
}

@keyframes traceFade{
  0%{opacity:0;transform:translateX(0)}
  20%{opacity:.8}
  100%{opacity:0;transform:translateX(-40px)}
}

@keyframes cherryPrint{
  0%{transform:translate(-50%,-30px) scale(.2);opacity:0}
  55%{transform:translate(-50%,0) scale(1.1);opacity:1}
  100%{transform:translate(-50%,0) scale(1);opacity:1}
}

@keyframes particlePop{
  0%{opacity:0;transform:translateY(15px) scale(.5)}
  50%{opacity:1}
  100%{opacity:0;transform:translateY(-25px) scale(1.1)}
}

@keyframes smokeUp{
  50%{transform:translateY(-12px) scale(1.25);opacity:.35}
}

@keyframes cherryFloat{
  50%{transform:translateY(-9px) rotate(4deg)}
}


/* ============================================================
   MOBILE
   ============================================================ */

@media(max-width:900px){

  .leadership-cards{
    grid-template-columns:repeat(2,1fr);
  }

  .proud-cards{
    grid-template-columns:repeat(2,1fr);
  }

}

@media(max-width:650px){

  .charvy-special-section{
    width:calc(100% - 30px);
    margin:85px auto;
  }

  .charvy-id-card{
    min-height:420px;
  }

  .id-monogram{
    width:180px;
    height:180px;
  }

  .monogram-circle span{
    font-size:50px;
  }

  .leadership-cards,
  .proud-cards{
    grid-template-columns:1fr;
  }

  .workshop-card{
    grid-template-columns:55px 1fr;
  }

  .workshop-card>b{
    display:none;
  }

  .special-heading h2,
  .proud-heading h2,
  .interest-title h2{
    font-size:47px;
  }

  .mini-project-stage{
    height:185px;
  }

}


/* ============================================================
   CHARVY 4V — CLEAN PROJECT + CARD DECK SYSTEM
   ============================================================ */

:root{
  --charvy-red:#a72f36;
  --charvy-red-light:#c75b61;
  --charvy-cream:#f4f0e8;
  --charvy-paper:#eee9df;
  --charvy-white:#fffaf2;
  --charvy-ink:#171717;
  --charvy-grey:#77736d;
  --charvy-steel:#777b80;
}


/* ============================================================
   THINGS I'VE BUILT & EXPLORED
   ============================================================ */

.built-section{
  width:min(1180px,calc(100% - 48px));
  margin:120px auto;
  position:relative;
}

.built-section:before{
  content:"";
  position:absolute;
  z-index:-2;
  left:50%;
  top:-80px;
  bottom:-80px;
  width:100vw;
  transform:translateX(-50%);
