/* ============================================================
   LEADERSHIP — ROTATING CARD DECK
   ============================================================ */

.rotating-leadership{
  width:min(1180px,calc(100% - 48px));
  margin:125px auto;
}

.rotating-heading{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:30px;
  align-items:end;
  margin-bottom:45px;
}

.rotating-heading>span{
  grid-column:1/-1;
  margin-bottom:-22px;
  color:#a72f36;
  font:600 9px monospace;
  letter-spacing:.15em;
}

.rotating-heading h2{
  margin:0;
  font-size:clamp(47px,6vw,75px);
  line-height:.87;
  letter-spacing:-.065em;
}

.rotating-heading h2 em{
  font-family:Georgia,serif;
  font-weight:400;
}

.rotating-heading p{
  max-width:300px;
  margin:0;
  font-size:12px;
  line-height:1.7;
  opacity:.55;
}

.leadership-carousel{
  position:relative;
  height:320px;
  max-width:610px;
  margin:0 auto;
  perspective:1200px;
}

.lead-card{
  position:absolute;
  inset:0;
  padding:30px;
  border:1px solid rgba(23,23,23,.11);
  border-radius:22px;
  background:#fffaf2;
  box-shadow:0 20px 50px rgba(23,23,23,.08);
  opacity:0;
  transform:
    translateX(70px)
    rotateY(-14deg)
    scale(.9);
  transition:
    transform .65s cubic-bezier(.2,.8,.2,1),
    opacity .45s ease;
  pointer-events:none;
}

.lead-card.lead-active{
  opacity:1;
  transform:
    translateX(0)
    rotateY(0)
    scale(1);
  z-index:10;
  pointer-events:auto;
}

.lead-card.lead-next{
  opacity:.42;
  transform:
    translateX(28px)
    rotateY(-8deg)
    scale(.95);
  z-index:5;
}

.lead-card-top{
  display:flex;
  justify-content:space-between;
  color:#a72f36;
  font:600 8px monospace;
  letter-spacing:.13em;
}

.lead-icon{
  margin:38px 0 28px;
  font-size:38px;
}

.lead-card h3{
  margin:0 0 8px;
  font-size:28px;
  letter-spacing:-.04em;
}

.lead-card p{
  margin:0;
  font-size:12px;
  opacity:.52;
}

.leadership-controls{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:22px;
  margin-top:24px;
}

.leadership-controls button{
  width:38px;
  height:38px;
  border:1px solid rgba(23,23,23,.15);
  border-radius:50%;
  background:transparent;
  cursor:pointer;
  transition:.25s;
}

.leadership-controls button:hover{
  color:white;
  background:#a72f36;
  border-color:#a72f36;
}

.leadership-controls span{
  font:600 9px monospace;
  opacity:.5;
}

.leadership-controls b{
  color:#a72f36;
}


/* ============================================================
   BIG WORKSHOP / EXPOSURE
   ============================================================ */

.beautiful-exposure{
  width:min(1180px,calc(100% - 48px));
  margin:120px auto;
  padding:80px 0;
  position:relative;
}

.beautiful-exposure:before{
  content:"";
  position:absolute;
  z-index:-2;
  left:50%;
  top:0;
  bottom:0;
  width:100vw;
  transform:translateX(-50%);
  background:#eee9df;
}

.exposure-top{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:35px;
  align-items:end;
  margin-bottom:50px;
}

.exposure-top>span{
  grid-column:1/-1;
  margin-bottom:-25px;
  color:#a72f36;
  font:600 9px monospace;
  letter-spacing:.15em;
}

.exposure-top h2{
  margin:0;
  font-size:clamp(52px,7vw,88px);
  line-height:.83;
  letter-spacing:-.07em;
}

.exposure-top h2 em{
  font-family:Georgia,serif;
  font-weight:400;
}

.exposure-top p{
  max-width:310px;
  margin:0;
  font-size:12px;
  line-height:1.7;
  opacity:.55;
}

.exposure-cards{
  display:grid;
  grid-template-columns:1.35fr 1fr 1fr;
