   ============================================================ */

.cool-cyber{
  position:absolute;
  right:30px;
  top:50%;
  width:125px;
  height:125px;
  transform:translateY(-50%);
}

.scan-circle{
  position:absolute;
  border:1px solid rgba(167,47,54,.22);
  border-radius:50%;
}

.scan-big{inset:2px}
.scan-mid{inset:20px}
.scan-small{inset:38px}

.scan-cross{
  position:absolute;
  background:rgba(167,47,54,.14);
}

.scan-cross.vertical{
  width:1px;
  height:100%;
  left:50%;
}

.scan-cross.horizontal{
  width:100%;
  height:1px;
  top:50%;
}

.scan-beam{
  position:absolute;
  left:50%;
  top:50%;
  width:50%;
  height:2px;
  transform-origin:left center;
  background:linear-gradient(
    90deg,
    #a72f36,
    rgba(167,47,54,0)
  );
  box-shadow:0 0 12px rgba(167,47,54,.55);
  animation:coolScanRotate 2.4s linear infinite;
}

.scan-center{
  position:absolute;
  z-index:5;
  left:50%;
  top:50%;
  width:50px;
  height:50px;
  transform:translate(-50%,-50%);
  display:grid;
  place-items:center;
  border:1px solid rgba(167,47,54,.3);
  border-radius:50%;
  background:#f4f0e8;
  font-size:25px;
  box-shadow:0 8px 22px rgba(23,23,23,.08);
  animation:scanCenterPulse 1.8s infinite;
}

.scan-point{
  position:absolute;
  width:7px;
  height:7px;
  border-radius:50%;
  background:#a72f36;
  box-shadow:0 0 10px rgba(167,47,54,.65);
  animation:scanPoint 1.5s infinite;
}

.sp1{
  left:9px;
  top:25px;
}

.sp2{
  right:7px;
  top:42px;
  animation-delay:.4s;
}

.sp3{
  left:30px;
  bottom:6px;
  animation-delay:.8s;
}

.scan-label{
  position:absolute;
  left:50%;
  bottom:-24px;
  transform:translateX(-50%);
  white-space:nowrap;
  color:#a72f36;
  font:600 7px monospace;
  letter-spacing:.13em;
}

.scan-label i{
  display:inline-block;
  width:5px;
  height:5px;
  margin-right:5px;
  border-radius:50%;
  background:#a72f36;
  animation:scanBlink 1s infinite;
}

@keyframes coolScanRotate{
  to{
    transform:rotate(360deg);
  }
}

@keyframes scanCenterPulse{
  50%{
    box-shadow:
      0 8px 22px rgba(23,23,23,.08),
      0 0 0 9px rgba(167,47,54,.045);
  }
}

@keyframes scanPoint{
  50%{
    transform:scale(1.7);
    opacity:.4;
  }
}

@keyframes scanBlink{
  50%{
    opacity:.25;
  }
}


