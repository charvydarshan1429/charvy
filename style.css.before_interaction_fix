/* ============================================================
   CYBER MINI
   ============================================================ */

.cyber-mini{
  height:300px;
  margin:18px 0 23px;
  position:relative;
  overflow:hidden;
  border-radius:17px;
  background:
    radial-gradient(circle at 50% 50%,rgba(167,47,54,.16),transparent 36%),
    #1c1a1a;
  border:1px solid rgba(167,47,54,.3);
}

.cyber-grid{
  position:absolute;
  inset:0;
  background-image:
    linear-gradient(rgba(199,91,97,.07) 1px,transparent 1px),
    linear-gradient(90deg,rgba(199,91,97,.07) 1px,transparent 1px);
  background-size:32px 32px;
  animation:cyberGridMove 5s linear infinite;
}

.cyber-radar{
  position:absolute;
  width:190px;
  height:190px;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  border:1px solid rgba(199,91,97,.45);
  border-radius:50%;
  box-shadow:0 0 35px rgba(167,47,54,.1);
}

.radar-circle{
  position:absolute;
  border:1px solid rgba(199,91,97,.2);
  border-radius:50%;
}

.r1{inset:20%}
.r2{inset:35%}
.r3{inset:50%}

.radar-cross{
  position:absolute;
  background:rgba(199,91,97,.18);
}

.r-vertical{
  width:1px;
  height:100%;
  left:50%;
}

.r-horizontal{
  height:1px;
  width:100%;
  top:50%;
}

.radar-sweep{
  position:absolute;
  left:50%;
  top:50%;
  width:50%;
  height:2px;
  transform-origin:left;
  background:linear-gradient(90deg,#c75b61,transparent);
  box-shadow:0 0 14px rgba(199,91,97,.8);
  animation:radarSpin 2.7s linear infinite;
}

.radar-core{
  position:absolute;
  width:8px;
  height:8px;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  border-radius:50%;
  background:#c75b61;
  box-shadow:0 0 17px #c75b61;
  animation:corePulse 1.4s infinite;
}

.radar-dot{
  position:absolute;
  padding:5px 7px;
  border:1px solid rgba(199,91,97,.4);
  background:#211c1d;
  color:#e2a5a8;
  font:600 8px monospace;
  animation:nodePulse 2s ease-in-out infinite;
}

.dot-a{left:-20px;top:25%}
.dot-b{right:-20px;top:20%;animation-delay:.4s}
.dot-c{left:-15px;bottom:20%;animation-delay:.8s}
.dot-d{right:-15px;bottom:25%;animation-delay:1.2s}

.cyber-live{
  position:absolute;
  top:17px;
  left:18px;
  z-index:5;
  color:#e4b0b2;
  font:600 8px monospace;
  letter-spacing:.14em;
}

.cyber-live i{
  display:inline-block;
  width:6px;
  height:6px;
  margin-right:6px;
  border-radius:50%;
  background:#c75b61;
  box-shadow:0 0 10px #c75b61;
  animation:liveBlink 1s infinite;
}

.cyber-console{
  position:absolute;
  z-index:5;
  left:18px;
  bottom:17px;
  display:flex;
  flex-direction:column;
  gap:3px;
  padding:10px 13px;
  border-left:2px solid #a72f36;
  background:rgba(20,16,16,.75);
  font:9px/1.5 monospace;
  color:#bb8588;
}

.cyber-console strong{
  color:#eee;
  animation:consoleBlink 1.2s infinite;
}

.cyber-meter{
  position:absolute;
  right:18px;
  bottom:19px;
  width:130px;
  z-index:5;
  color:#c99395;
  font:8px monospace;
}

.cyber-meter div{
  height:3px;
  margin-top:7px;
